#!/bin/bash


filename=$(mktemp)
output="$5"
    
if [ "$1" == "prdme" ]; then
    user=roetsm
    db=themis
    sid=pps1
    pwd=${ROETSM_THEMIS_PWD}
fi
if [ "$1" == "prdsy" ]; then
    user=system
    db=themis
    sid=pps1
    pwd=${SYSTEM_THEMIS_PWD}
fi
if [ "$1" == "devme" ]; then
    user=roetsm
    db=themisdev
    sid=pps1
    pwd=${ROETSM_THEMISDEV_PWD}
fi
if [ "$1" == "devsy" ]; then
    user=system
    db=themisdev
    sid=pps1
    pwd=${SYSTEM_THEMISDEV_PWD}
fi
lower_owner=$(echo "$2" | tr '[:upper:]' '[:lower:]')
lower_name=$(echo "$3" | tr '[:upper:]' '[:lower:]')
lower_type=$(echo "$4" | tr '[:upper:]' '[:lower:]')
upper_owner=$(echo "$2" | tr '[:lower:]' '[:upper:]')
upper_name=$(echo "$3" | tr '[:lower:]' '[:upper:]')
upper_type=$(echo "$4" | tr '[:lower:]' '[:upper:]')
cat > $filename <<- EOM
connect $user/"$pwd"@$db/$sid
set heading off
set trimout on
set trimspool on
set linesize 220
set pagesize 0
set feedback off
set long 4000
set echo off
spool $output
select 'create or replace $lower_type $lower_owner.$lower_name as' from dual;
EOM

if [ "$upper_type" == "VIEW" ]; then
    echo "select text from all_views where view_name = '$upper_name' and owner = '$upper_owner';" >> $filename
else
    echo "select text from all_source where owner = '$upper_owner' and name = '$upper_name' and type = '$upper_type' and line >= 2 order by line;" >> $filename
fi

cat >> $filename <<- EOM
spool off
quit
EOM

sqlplus /nolog @$filename
echo $output
echo $filename
#rm $filename
