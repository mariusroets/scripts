#!/bin/bash

USERNAME="roetsm"
AUTHGROUP="Eskom"
VPN_SERVER="ssl.eskom.co.za"
# Wrapper around /etc/vpnc/vpnc-script that keeps the tunnel split (172/8 only)
# instead of stealing the default route. Adjust if you install it elsewhere.
VPNC_SCRIPT="/etc/vpnc/vpnc-split"
VPNPID=`pidof openconnect`

if [ "$1" == "status" ]; then
    if [ -n "$VPNPID" ]; then
        echo "VPN is running with pid $VPNPID"
    else
        echo "VPN is not running"
    fi
    exit 0
elif [ "$1" == "vpn" ]; then
    group="ESKOM-SECURE-VPN"
    server="vpn"
fi
if [ -n "$VPNPID" ]; then
    sudo kill -2 $VPNPID
else
    if [ ! -x "$VPNC_SCRIPT" ]; then
        echo "Error: $VPNC_SCRIPT is missing or not executable."
        exit 1
    fi

    echo "Connecting to VPN..."
    sudo openconnect -b -s "$VPNC_SCRIPT" -u $USERNAME --authgroup $AUTHGROUP --passwd-on-stdin $VPN_SERVER || exit 1

    # openconnect backgrounds itself before it configures the tunnel, so wait
    # for the split route to show up. This only reads state - the routes are
    # set up entirely by $VPNC_SCRIPT, so there is nothing to race with.
    echo "Waiting for VPN tunnel to establish..."
    for i in $(seq 1 30); do # Try for up to 15 seconds
        sleep 0.5
        if ip route show 172.0.0.0/8 dev tun0 2>/dev/null | grep -q .; then
            echo "Connected as $(ip -4 addr show tun0 | grep -oP 'inet \K[\d.]+'), 172.0.0.0/8 routed via tun0"
            exit 0
        fi
    done

    echo "Error: tunnel did not come up within the timeout. VPN connection failed?"
    exit 1
fi


