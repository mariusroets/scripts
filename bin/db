#!/bin/bash

if [ "$1" == "prdme" ]; then
    user=roetsm
    db=pps1
    server=themis
    port=1521
    pwd=${ROETSM_THEMIS_PWD}
    sid=pps1
    dbtype=oracle
    colour=31
    dev_session=""
fi
if [ "$1" == "prdsy" ]; then
    user=system
    db=pps1
    server=themis
    port=1521
    pwd=${SYSTEM_THEMIS_PWD}
    sid=pps1
    dbtype=oci
    colour=31
    dev_session=""
fi
if [ "$1" == "devme" ]; then
    user=roetsm
    db=pps1
    server=themisdev
    port=1521
    pwd=${ROETSM_THEMISDEV_PWD}
    sid=pps1
    dbtype=oracle
    colour=32
    dev_session="alter session set PLSQL_CCFLAGS = 'is_dev_env:true';"
fi
if [ "$1" == "devsy" ]; then
    user=system
    db=pps1
    server=themisdev
    port=1521
    pwd=${SYSTEM_THEMISDEV_PWD}
    sid=pps1
    dbtype=oci
    colour=32
    dev_session="alter session set PLSQL_CCFLAGS = 'is_dev_env:true';"
fi
#usql $dbtype://$user:$pwd@$server:$port/$db
filename=$(mktemp)
cat > $filename <<- EOM
connect $user/"$pwd"@$server/$sid
$dev_session

-- Use column wrapping to cleanly grab a real ANSI escape byte into a SQL*Plus variable
column esc_char new_value ESC
set termout off
select chr(27) as esc_char from dual;
set termout on

set sqlprompt "&ESC.[${colour}m _USER'@'_CONNECT_IDENTIFIER> &ESC.[0m"
EOM
echo $filename
cat $filename
rlwrap sqlplus /nolog @$filename
rm $filename
